#%PAM-1.0
#
# /etc/pam.d/postgresql , SSH-key auth for PostgreSQL
#
# Module options:
#   authorized_keys_dir=<dir>   Root dir for per-user authorized_keys.
#                               Files must be at <dir>/<username>/authorized_keys
#                               Default: /etc/pg_sshkeys
#
#   challenge_dir=<dir>         Where challenge nonces are stored.
#                               Default: /var/run/pg_sshkey
#
#   trusted_ca_keys=<file>      OpenSSH CA public keys, one per line
#                               (authorized_keys format, ssh-ed25519 or ssh-rsa).
#                               A user whose key carries a certificate signed
#                               by one of these CAs (pg_sshkey_connect --cert)
#                               authenticates without an authorized_keys file.
#                               The file must be owned root:postgres, mode 0640,
#                               not group or world writable. No default: when
#                               unset, certificate tokens are refused.
#                               Recommended: /etc/pg_sshkeys/trusted_ca_keys
#
#   debug                       Enable verbose syslog output.

auth    required    pam_pg_sshkey.so \
            authorized_keys_dir=/etc/pg_sshkeys \
            challenge_dir=/var/run/pg_sshkey

account required    pam_permit.so
